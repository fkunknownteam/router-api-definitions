{
  "$schema": "../../../../schema/api-definition.schema.json",
  "schemaVersion": "1.0",
  "definitionVersion": "1.0.0",
  "vendor": "tenda",
  "vendorName": "Tenda",
  "model": "AC10",
  "modelSlug": "ac10",
  "variant": "v4.0-fw16.03",
  "hardwareVersions": [
    "V4.0"
  ],
  "firmware": {
    "verified": "V16.03",
    "match": "prefix",
    "matchPrefix": "V16.03",
    "family": "goahead-aes-md5",
    "notes": "The exact build string varies (the Android adapter logs whatever the device reports) and no single full string is quoted here. Match on the V16.03 prefix and confirm adv_hard_ver before writing."
  },
  "identify": {
    "endpoint": "status.system",
    "field": "adv_hard_ver",
    "equals": "V4.0",
    "requiresAuth": true,
    "notes": "The surest test is behavioural: fetch the AES key, read status.router and decrypt it. A build that answers every getter with base64 that never decrypts is a different dialect, not a wrong password."
  },
  "transport": {
    "scheme": "http",
    "defaultHost": "192.168.0.1",
    "defaultPort": 80,
    "altHosts": [
      "tendawifi.com"
    ],
    "pathPrefix": "",
    "requestTimeoutMs": 12000,
    "verifyTls": true,
    "cacheBuster": "timestamp",
    "notes": "Getters are called with a nanosecond or millisecond cache-buster which the router ignores."
  },
  "session": {
    "type": "cookie-on-login",
    "maxConcurrentSessions": 1,
    "login": {
      "endpoint": "/login/Auth",
      "method": "POST",
      "body": {
        "username": "admin",
        "password": "{password}"
      },
      "passwordEncoding": "md5-hex",
      "success": {
        "kind": "body-number",
        "successCodes": [],
        "refusalCodes": {
          "1": "wrong-password",
          "2": "wrong-username",
          "3": "already-signed-in",
          "4": "locked-out"
        },
        "loginPageMarker": "<!DOCTYPE"
      },
      "notes": "The device answers a bare number, not a redirect, so success must be confirmed by the cookie as well as by the code. A refused login still returns the full main page, so a body-is-a-page test misreads it as success."
    },
    "logout": {
      "endpoint": "/goform/exit",
      "method": "GET"
    },
    "expiry": {
      "statusCodes": [
        302
      ],
      "bodyMarkers": [
        "<!DOCTYPE",
        "main.html"
      ],
      "redirectTo": "/login.html"
    },
    "lockout": {
      "probeEndpoint": "/goform/getLoginInfo",
      "attemptsField": "leftTimes",
      "lockedField": "isLocked"
    }
  },
  "crypto": {
    "type": "aes-128-cbc-base64",
    "iv": "EU5H62G9ICGRNI43",
    "ivEncoding": "ascii",
    "keySource": {
      "kind": "endpoint-field",
      "endpoint": "/goform/stokCfg",
      "field": "sign",
      "perRequest": true
    },
    "appliesTo": {
      "request": true,
      "response": true
    },
    "plaintextPaths": [
      "/login/Auth",
      "/goform/stokCfg",
      "/goform/getLoginInfo",
      "/goform/SysToolReboot"
    ],
    "notes": "AES-128-CBC, PKCS5/7 padding, base64 on the wire. The sign key is regenerated on every call: fetch it immediately before the request it protects and decrypt the reply with that same key. A cached key yields garbage that looks like corrupt data."
  },
  "envelopes": {
    "resultField": "errCode",
    "successValue": 0,
    "errorCodes": [
      {
        "code": 1,
        "reason": "rejected"
      },
      {
        "code": 2,
        "reason": "another-admin"
      },
      {
        "code": 3,
        "reason": "busy"
      }
    ],
    "nonJsonEndpoints": [
      "/login/Auth",
      "/goform/stokCfg",
      "/goform/getLoginInfo",
      "/goform/SysToolReboot",
      "/goform/exit"
    ],
    "notes": "errCode is an unquoted JSON number after decryption. A 302 or a body containing main.html mid-flight means the session slot died, not that the request was rejected."
  },
  "endpoints": [
    {
      "id": "session.login",
      "path": "/login/Auth",
      "method": "POST",
      "purpose": "Authenticate the admin session.",
      "uiPage": "login page",
      "feature": "status",
      "request": {
        "bodyEncoding": "form",
        "fields": [
          {
            "name": "username",
            "type": "string",
            "notes": "Defaults to admin when the app stores no username."
          },
          {
            "name": "password",
            "type": "string",
            "secret": true,
            "notes": "MD5 hex of the plaintext password."
          }
        ]
      },
      "response": {
        "kind": "text"
      },
      "risk": "safe",
      "verified": "app-observed",
      "evidence": "Exercised by the Android adapter against an AC10 V4 running V16.03.x. Refusal codes handled in Ac10RouterAdapter.loginBlocking().",
      "notes": "Reply is a bare number of at most four characters: 1 wrong password, 2 wrong username, 3 already signed in, 4 locked. Anything else is success, confirmed by the session cookie appearing. A full page body means the session slot is gone, not that login worked."
    },
    {
      "id": "session.key",
      "path": "/goform/stokCfg",
      "method": "GET",
      "purpose": "Fetch the per-request AES key.",
      "uiPage": "every authenticated page",
      "feature": "status",
      "response": {
        "kind": "json-object",
        "fields": [
          {
            "name": "sign",
            "type": "string",
            "secret": true
          }
        ]
      },
      "risk": "safe",
      "verified": "app-observed",
      "evidence": "Fetched before every authenticated request by the Android adapter."
    },
