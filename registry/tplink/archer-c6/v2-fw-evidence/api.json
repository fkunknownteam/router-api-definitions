{
  "$schema": "https://raw.githubusercontent.com/fkunknownteam/router-api-definitions/main/schema/api-definition.schema.json",
  "schemaVersion": "1.0",
  "definitionVersion": "1.0.0",
  "vendor": "tplink",
  "vendorName": "TP-Link",
  "model": "ARCHER-C6",
  "modelSlug": "archer-c6",
  "variant": "v2-fw-evidence",
  "hardwareVersions": [
    "V2",
    "V2.80"
  ],
  "firmware": {
    "match": "family",
    "verified": "20260902",
    "notes": "Derived from ArcherC6v2_us_tw_c6us-up-ver1-2-1-P1[20260902-rel38654].bin, firmware 1.2.1 Build 260902 (US), published 2026-10-19. The same image is listed for hardware V2 and V2.80."
  },
  "transport": {
    "scheme": "http",
    "defaultHost": "192.168.0.1",
    "defaultPort": 80,
    "altHosts": [
      "tplinkwifi.net",
      "192.168.1.1"
    ],
    "pathPrefix": "",
    "requestTimeoutMs": 12000,
    "verifyTls": true,
    "cacheBuster": "none",
    "notes": "The C6 answers on 192.168.0.1 out of the box and moves to 192.168.1.1 when it detects an upstream conflict; the firmware ships both. Which one a given unit uses was not captured, so the client should probe."
  },
  "session": {
    "type": "cookie-on-login",
    "maxConcurrentSessions": 1,
    "login": {
      "endpoint": "/login?form=login",
      "method": "POST",
      "kind": "challenge",
      "verified": "ui-code",
      "payloadEncoding": "form",
      "success": {
        "kind": "json-token",
        "tokenField": "stok"
      },
      "challenge": {
        "issuer": {
          "endpoint": "/login?form=auth",
          "method": "GET",
          "extract": {
            "format": "json",
            "map": {
              "nn": "key.0",
              "ee": "key.1",
              "seq": "seq"
            }
          }
        },
        "hash": "md5-hex-of-username-plus-password",
        "cipher": {
          "type": "aes-128-cbc-base64",
          "keyChars": 16,
          "ivChars": 16,
          "charset": "digits",
          "keyReport": "k=%key%&i=%iv%"
        },
        "signature": {
          "type": "rsa-pkcs1-v1_5",
          "bits": 512,
          "plaintext": "%keyReport%&h=%hash%&s=%seqPlusDataLen%"
        },
        "envelope": "sign=%sign%&data=%data%",
        "payload": "form-body",
        "payloadTemplate": "operation=login&password={password}"
      }
    }
  },
