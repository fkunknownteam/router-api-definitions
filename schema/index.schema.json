{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fkunknownteam/router-api-definitions/main/schema/index.schema.json",
  "title": "Definition index",
  "description": "Generated by tools/build_index.py. A client fetches this once, picks the variant whose matchPrefix fits the firmware string reported by the device, downloads api.json and capabilities.json, and verifies both against the sha256 recorded here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rawBase", "vendors", "definitions"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"type": "string", "const": "1.0"},
    "generatedBy": {"type": "string"},
    "rawBase": {"type": "string"},
    "vendorNames": {
      "description": "Display names for the picker, keyed by vendor slug.",
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "vendors": {"type": "object", "additionalProperties": {"$ref": "#/$defs/modelList"}},
    "definitions": {"type": "array", "items": {"$ref": "#/$defs/definition"}}
  },
  "$defs": {
    "modelList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "slug", "variants"],
        "properties": {
          "model": {"type": "string"},
          "slug": {"type": "string"},
          "variantCount": {"type": "integer"},
          "variants": {"type": "array", "items": {"$ref": "#/$defs/definition"}}
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "apiUrl", "capabilitiesUrl", "definitionVersion", "schemaVersion", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "label": {
          "description": "Human-readable line for the firmware picker, e.g. 'Hardware V3.0 — firmware V03.03.16.11_multi'.",
          "type": "string"
        },
        "apiUrl": {"type": "string"},
        "capabilitiesUrl": {"type": "string"},
        "definitionVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "schemaVersion": {"type": "string"},
        "firmware": {"type": ["string", "null"]},
        "matchPrefix": {"type": ["string", "null"]},
        "match": {"enum": ["exact", "prefix", "family", null], "description": "How to compare the device's firmware string. 'family' means no usable version was published and the client must identify the device from its own UI."},
        "hardwareVersions": {"type": "array", "items": {"type": "string"}},
        "endpointCount": {"type": "integer"},
        "sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api", "capabilities"],
          "properties": {
            "api": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "capabilities": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    }
  }
}
